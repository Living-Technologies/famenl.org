---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Home">
  <!-- HERO -->
  <header style="position:relative;background:linear-gradient(135deg,#2d6a4f 0%,#40916c 100%);color:#fff;padding:2.5rem 2rem 4.5rem;text-align:center;overflow:hidden;">
    <div style="display:inline-block;background:rgba(255,255,255,.18);border:1px solid rgba(255,255,255,.35);border-radius:100px;padding:.25rem .9rem;font-size:.8rem;font-weight:600;letter-spacing:.06em;text-transform:uppercase;margin-bottom:1.5rem;">
      FAIR Metadata Exchange · Netherlands
    </div>
    <h1 style="font-family:'Lora',Georgia,serif;font-size:clamp(1.8rem,4vw,2.8rem);font-weight:600;line-height:1.25;max-width:820px;margin:0 auto 1.25rem;">
      A FAIR Metadata Exchange Catalogue for Dutch Life Science Research
    </h1>
    <p style="font-size:1.05rem;opacity:.88;max-width:640px;margin:0 auto;">
      FAMENL develops shared metadata infrastructure that bridges domain-specific research platforms,
      making life science data truly findable, accessible, interoperable, and reusable.
    </p>
    <svg viewBox="0 0 1440 100" preserveAspectRatio="none" style="position:absolute;bottom:-1px;left:0;width:100%;height:70px;display:block;">
      <path fill="#ffffff" d="M0,32L80,37.3C160,43,320,53,480,50.7C640,48,800,32,960,26.7C1120,21,1280,27,1360,29.3L1440,32L1440,100L1360,100C1280,100,1120,100,960,100C800,100,640,100,480,100C320,100,160,100,80,100L0,100Z"></path>
    </svg>
  </header>

  <!-- INTRO -->
  <section>
    <div class="prose">
      <div class="section-label">Overview</div>
      <h2 class="section-title">The Challenge</h2>
      <p class="section-lead">
        Dutch life science research infrastructures each manage their data in isolation. Bioimaging platforms,
        omics pipelines, and environmental monitoring systems have evolved independently, making cross-domain
        data discovery and reuse far harder than it needs to be.
      </p>
      <blockquote style="border-left:4px solid #52b788;background:#d8f3dc;border-radius:0 10px 10px 0;padding:1.25rem 1.5rem;font-family:'Lora',Georgia,serif;font-style:italic;font-size:1.05rem;color:#2d6a4f;">
        "OMERO cannot store omics data, such as those generated in UNLOCK and vice versa"
      </blockquote>
      <p style="color:var(--muted);margin-top:1.5rem;">
        FAMENL addresses this by building FAIR metadata management layers that bridge domain-specific platforms
        with generic storage solutions. Using the ISA standard, FAIRDOM-SEEK, and RO-Crate packaging, the project
        delivers simple, tabular metadata templates that empower researchers to produce standards-compliant data
        without requiring deep technical expertise.
      </p>
    </div>
  </section>

  <!-- DIAGRAM -->
  <section style="background:var(--white);">
    <div class="prose">
      <img
        src="/famenl-diagram.png"
        alt="FAMENL platform diagram showing the flow from laboratory experiments and detectors through iRODS storage and SEEK to public archives and analysis tools"
        style="width:100%;height:auto;border-radius:var(--radius);box-shadow:var(--shadow);"
      />
    </div>
  </section>

  <!-- QUICK LINKS -->
  <section style="background:var(--white);">
    <div class="prose">
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:1.25rem;">
        {[
          { href: '/about',     label: 'About FAMENL', desc: 'Goals, context, and motivation' },
          { href: '/platforms', label: 'Platforms',   desc: 'Aligned tools & applications' },
          { href: '/partners',  label: 'Partners',    desc: 'Participating organizations' },
          { href: '/team',      label: 'Team',        desc: 'People behind FAMENL' },
        ].map(({ href, label, desc }) => (
          <a href={href} style="display:block;background:var(--bg);border:1px solid var(--border);border-radius:var(--radius);padding:1.5rem;text-decoration:none;transition:transform .15s,box-shadow .15s;" onmouseover="this.style.transform='translateY(-2px)';this.style.boxShadow='0 6px 20px rgba(0,0,0,.1)'" onmouseout="this.style.transform='';this.style.boxShadow=''">
            <div style="font-weight:600;color:var(--text);margin-bottom:.3rem;">{label}</div>
            <div style="font-size:.875rem;color:var(--muted);">{desc}</div>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>
