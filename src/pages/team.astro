---
import Layout from '../layouts/Layout.astro';
import members from '../data/team.json';
---
<Layout title="Team">
  <section>
    <div class="container">
      <div class="section-label">People</div>
      <h1 class="section-title">Meet the Team</h1>
      <p class="section-lead">
        The people driving FAMENL forward, bringing expertise in bioinformatics, knowledge representation, and
        research infrastructure.
      </p>
      <div id="team-grid" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:1.5rem;">
        {members.map(m => (
          <div style="background:var(--white);border:1px solid var(--border);border-radius:var(--radius);overflow:hidden;box-shadow:var(--shadow);text-align:center;display:flex;flex-direction:column;height:100%;">
            <div style="background:var(--green-xl);padding:2rem 2rem 1.25rem;">
              {/* Swap src for a real photo once available — falls back to initials circle */}
              <div style="width:96px;height:96px;border-radius:50%;margin:0 auto;overflow:hidden;border:3px solid var(--white);box-shadow:0 2px 8px rgba(0,0,0,.12);">
                <img
                  src={m.photo}
                  alt={m.name}
                  width="96"
                  height="96"
                  style="width:100%;height:100%;object-fit:cover;"
                  onerror={`this.style.display='none';this.nextElementSibling.style.display='flex'`}
                />
                <div style="display:none;width:100%;height:100%;background:var(--green);color:#fff;font-weight:700;font-size:1.4rem;align-items:center;justify-content:center;">
                  {m.initials}
                </div>
              </div>
            </div>
            <div style="padding:1rem 1.25rem 1.5rem;display:flex;flex-direction:column;flex:1;">
              <h2 style="font-size:1rem;font-weight:600;margin-bottom:.25rem;">{m.name}</h2>
              <div style="font-size:.875rem;color:var(--accent);font-weight:500;margin-bottom:.2rem;">{m.role}</div>
              <a href={m.affiliationUrl} target="_blank" rel="noopener noreferrer" style="font-size:.8rem;color:var(--muted);margin-bottom:.6rem;display:block;text-decoration:none;transition:color .15s;" onmouseover="this.style.color='var(--green)'" onmouseout="this.style.color='var(--muted)'">{m.affiliation}</a>
              <div style="font-size:.85rem;color:var(--muted);line-height:1.5;">{m.bio}</div>
              {(m.orcid || m.linkedin || m.website) && (
                <div style="display:flex;justify-content:center;gap:.6rem;margin-top:auto;padding-top:.85rem;">
                  {m.orcid && (
                    <a href={m.orcid} target="_blank" rel="noopener noreferrer" aria-label={`${m.name} on ORCID`} title="ORCID" style="display:inline-flex;align-items:center;">
                      <img src="/icons/orcid.gif" width="16" height="16" alt="ORCID" />
                    </a>
                  )}
                  {m.linkedin && (
                    <a href={m.linkedin} target="_blank" rel="noopener noreferrer" aria-label={`${m.name} on LinkedIn`} title="LinkedIn" style="display:inline-flex;align-items:center;">
                      <img src="/icons/linkedin.png" width="16" height="16" alt="LinkedIn" />
                    </a>
                  )}
                  {m.website && (
                    <a href={m.website} target="_blank" rel="noopener noreferrer" aria-label={`${m.name} personal website`} title="Website" style="display:inline-flex;color:var(--muted);transition:color .15s;" onmouseover="this.style.color='var(--green)'" onmouseout="this.style.color='var(--muted)'">
                      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <circle cx="12" cy="12" r="10"/>
                        <line x1="2" y1="12" x2="22" y2="12"/>
                        <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
                      </svg>
                    </a>
                  )}
                </div>
              )}
            </div>
          </div>
        ))}
      </div>
      {/* To add a photo, place a JPEG named after the person (e.g. jasper-koehorst.jpg) in the public/team/ folder. It will appear automatically. */}
    </div>
  </section>
</Layout>

<script>
  const grid = document.getElementById('team-grid');
  if (grid) {
    const cards = [...grid.children];
    for (let i = cards.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      grid.appendChild(cards[j]);
      cards.splice(j, 1);
    }
  }
</script>
