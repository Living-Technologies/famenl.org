---
import Layout from '../layouts/Layout.astro';

const platforms = [
  {
    name: 'FAIRDOM-SEEK',
    initials: 'SK',
    description: 'A web-based resource for sharing scientific research assets. Used as the integrated platform for managing experimental metadata across life science research infrastructures.',
    url: 'https://seek.famenl.org',
  },
  {
    name: 'FAIR-DS',
    initials: 'FDS',
    description: 'A tool that enables researchers to create FAIR metadata for their datasets using simple, guided templates without requiring deep technical knowledge.',
    url: 'https://fairds.famenl.org',
  },
  {
    name: 'FAIR Data Points',
    initials: 'FDP',
    description: 'A metadata repository that exposes dataset descriptions in a standardised, machine-readable way, enabling discovery and access across distributed research infrastructures.',
    url: 'https://docs.fairdatapoint.org',
  },
  {
    name: 'OMERO',
    initials: 'OM',
    description: 'An open-source platform for managing, visualising, and analysing biological microscopy images. A key tool for bioimaging metadata integration within FAMENL.',
    url: 'https://www.openmicroscopy.org/omero/',
  },
];
---
<Layout title="Platforms">
  <section>
    <div class="container">
      <div class="section-label">Tools & Platforms</div>
      <h1 class="section-title">Aligned Applications</h1>
      <p class="section-lead">
        FAMENL builds on and aligns with established open platforms for research data management,
        metadata exchange, and FAIR compliance across life science domains.
      </p>
      <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:1.25rem;">
        {platforms.map(p => (
          <a
            href={p.url}
            target="_blank"
            rel="noopener noreferrer"
            style="background:var(--white);border:1px solid var(--border);border-radius:var(--radius);padding:1.75rem;text-decoration:none;display:flex;flex-direction:column;gap:.75rem;box-shadow:var(--shadow);transition:transform .15s,box-shadow .15s;"
            onmouseover="this.style.transform='translateY(-2px)';this.style.boxShadow='0 6px 20px rgba(0,0,0,.1)'"
            onmouseout="this.style.transform='';this.style.boxShadow=''"
          >
            <div style="display:flex;align-items:center;gap:.9rem;">
              <div style="flex-shrink:0;width:44px;height:44px;border-radius:10px;background:var(--green-xl);color:var(--green);font-weight:700;font-size:.8rem;display:flex;align-items:center;justify-content:center;">
                {p.initials}
              </div>
              <h2 style="font-size:1.05rem;font-weight:600;color:var(--text);">{p.name}</h2>
            </div>
            <p style="font-size:.9rem;color:var(--muted);line-height:1.6;">{p.description}</p>
            <span style="font-size:.8rem;color:var(--accent);margin-top:auto;">{p.url.replace(/^https?:\/\//, '')} ↗</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>
