---
interface Props {
  title: string;
  description?: string;
}
const { title, description = 'Towards Practical FAIR Metadata Use in Life Science Research Infrastructures' } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} | FAMENL</title>
  <meta name="description" content={description} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Lora:ital,wght@0,600;1,400&display=swap" rel="stylesheet" />
  <style is:global>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --green:   #2d6a4f;
      --green-l: #40916c;
      --green-xl:#d8f3dc;
      --accent:  #52b788;
      --text:    #1b2332;
      --muted:   #4a5568;
      --border:  #e2e8f0;
      --bg:      #f8fafc;
      --white:   #ffffff;
      --radius:  10px;
      --shadow:  0 2px 12px rgba(0,0,0,.07);
    }
    html { scroll-behavior: smooth; }
    body {
      font-family: 'Inter', system-ui, sans-serif;
      color: var(--text);
      background: var(--bg);
      line-height: 1.65;
      font-size: 16px;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }
    main { flex: 1; }
    a { color: var(--green-l); }

    /* NAV */
    nav {
      position: sticky; top: 0; z-index: 100;
      background: rgba(255,255,255,.92);
      backdrop-filter: blur(8px);
      border-bottom: 1px solid var(--border);
      padding: 0 2rem;
    }
    .nav-inner {
      max-width: 1100px; margin: 0 auto;
      display: flex; align-items: center; justify-content: space-between;
      height: 60px; gap: 1.5rem;
    }
    .nav-logo {
      font-weight: 700; font-size: 1.1rem; color: var(--green);
      text-decoration: none; letter-spacing: -.02em;
    }
    .nav-links { display: flex; gap: 1.5rem; list-style: none; }
    .nav-links a {
      text-decoration: none; color: var(--muted);
      font-size: .9rem; font-weight: 500; transition: color .15s;
    }
    .nav-links a:hover, .nav-links a.active { color: var(--green); }

    /* FOOTER */
    footer {
      background: var(--text); color: rgba(255,255,255,.65);
      text-align: center; padding: 2.5rem 2rem 2rem;
      font-size: .875rem;
    }
    footer strong { color: var(--white); }
    footer a { color: var(--accent); text-decoration: none; }
    .footer-funding {
      max-width: 1000px; margin: 0 auto;
      display: flex; flex-wrap: wrap; align-items: center; justify-content: center;
      gap: 2rem;
    }
    .footer-funding p {
      flex: 1 1 260px; max-width: 420px; margin: 0;
      text-align: left; line-height: 1.6;
    }
    .footer-logos {
      display: flex; flex-wrap: wrap; align-items: center; justify-content: center;
      gap: 1.25rem;
      flex: 2 1 400px;
    }
    .footer-logos img {
      height: 48px; width: 90px;
      object-fit: contain;
      background: var(--white);
      border-radius: 6px;
      padding: .5rem;
      transition: transform .15s;
    }
    .footer-logos a:hover img { transform: translateY(-2px); }

    /* SHARED LAYOUT PRIMITIVES */
    .container { max-width: 1100px; margin: 0 auto; padding: 0 2rem; }
    .prose { width: 80%; max-width: 860px; margin: 0 auto; text-align: left; }
    .section-label {
      font-size: .75rem; font-weight: 700; letter-spacing: .1em;
      text-transform: uppercase; color: var(--accent); margin-bottom: .6rem;
    }
    .section-title {
      font-family: 'Lora', Georgia, serif;
      font-size: clamp(1.4rem, 2.5vw, 2rem);
      font-weight: 600; margin-bottom: 1rem;
    }
    .section-lead {
      color: var(--muted);
      margin-bottom: 2.5rem; font-size: 1.02rem;
    }
    section { padding: 4rem 2rem; }
    section:nth-child(even) { background: var(--white); }

    @media (max-width: 640px) {
      .nav-links { display: none; }
    }
  </style>
</head>
<body>
  <nav>
    <div class="nav-inner">
      <a class="nav-logo" href="/">FAMENL</a>
      <ul class="nav-links">
        <li><a href="/">Home</a></li>
        <li><a href="/about">About</a></li>
        <li><a href="/platforms">Platforms</a></li>
        <li><a href="/partners">Partners</a></li>
        <li><a href="/team">Team</a></li>
      </ul>
    </div>
  </nav>
  <main>
    <slot />
  </main>
  <footer>
    <div class="footer-funding">
      <p><strong>FAMENL</strong> is funded by the NWO - TDCC LSH 2023 call aimed at strengthening digital competences in the data-driven life sciences and health domain.</p>
      <div class="footer-logos">
        <a href="https://www.nwo.nl" target="_blank" rel="noopener noreferrer"><img src="/footer/nwo.svg" alt="NWO" /></a>
        <a href="https://www.tdcc.nl" target="_blank" rel="noopener noreferrer"><img src="/footer/tdcc-lsh.png" alt="TDCC-LSH" /></a>
        <a href="https://www.hdmt.technology/" target="_blank" rel="noopener noreferrer"><img src="/partners/hdmt.jpg" alt="hDMT-INFRA-StemCells" /></a>
        <a href="https://nemi.microscopie.nl/" target="_blank" rel="noopener noreferrer"><img src="/partners/nemi.jpg" alt="NEMI" /></a>
        <a href="https://eurobioimaging.nl/" target="_blank" rel="noopener noreferrer"><img src="/partners/nl-bioimaging.jpg" alt="NL-BioImaging" /></a>
        <a href="https://m-unlock.com/" target="_blank" rel="noopener noreferrer"><img src="/partners/unlock.svg" alt="UNLOCK" /></a>
        <a href="https://www.wur.nl" target="_blank" rel="noopener noreferrer"><img src="/partners/wur.jpg" alt="Wageningen University & Research" /></a>
        <a href="https://x-omics.nl" target="_blank" rel="noopener noreferrer"><img src="/partners/x-omics.jpg" alt="X-OMICS" /></a>
      </div>
    </div>
  </footer>
</body>
</html>
